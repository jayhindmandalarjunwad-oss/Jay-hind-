rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role in ['ADMIN', 'SUPER_ADMIN'] || request.auth.token.admin == true);
    }

    function isApprovedMember() {
      return isAuthenticated() && 
        (getUserData().status == 'APPROVED' || isAdmin());
    }

    // 1. Users Collection
    match /users/{userId} {
      // Approved members and admins can view member directory
      allow read: if isAuthenticated();

      // Registration: User can create their initial profile as PENDING_APPROVAL with role MEMBER
      allow create: if isAuthenticated() && (
        isOwner(userId) && 
        request.resource.data.role in ['MEMBER', 'USER'] &&
        request.resource.data.status == 'PENDING_APPROVAL' &&
        !('password' in request.resource.data)
      ) || isAdmin();

      // Update: User can update their non-sensitive profile info; Admins can update roles/status
      allow update: if (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isAdmin', 'password'])
      ) || isAdmin();

      // Delete: Only admins can delete accounts
      allow delete: if isAdmin();
    }

    // 2. Posts Collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      // Approved members can create posts
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      // Author can update post, or any authenticated user can update likes count/list
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedUserIdsJson', 'commentsCount'])
      );
      // Author or admin can delete post
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 3. Comments Collection
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 4. Chat Messages Collection (Supports both chat_messages and chatMessages)
    match /{chatCol}/{messageId} {
      allow read: if isAuthenticated() && (chatCol == 'chat_messages' || chatCol == 'chatMessages');
      allow create: if isAuthenticated() && 
        (chatCol == 'chat_messages' || chatCol == 'chatMessages') && 
        request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        (chatCol == 'chat_messages' || chatCol == 'chatMessages') && 
        (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // 5. Events Collection
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Announcements Collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Albums Collection
    match /albums/{albumId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Photos Collection
    match /photos/{photoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 9. Emergency Blood Alerts Collection
    match /{bloodCol}/{alertId} {
      allow read: if isAuthenticated() && 
        (bloodCol == 'emergency_blood_alerts' || bloodCol == 'emergencyBloodAlerts');
      allow create: if isAuthenticated() && 
        (bloodCol == 'emergency_blood_alerts' || bloodCol == 'emergencyBloodAlerts');
      allow update: if isAuthenticated() && 
        (bloodCol == 'emergency_blood_alerts' || bloodCol == 'emergencyBloodAlerts') && 
        (resource.data.requestedByUserId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && 
        (bloodCol == 'emergency_blood_alerts' || bloodCol == 'emergencyBloodAlerts');
    }

    // 10. Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.targetUserId == request.auth.uid);
    }

    // 11. Mandal Info (Live Streaming, Settings)
    match /{infoCol}/{infoId} {
      allow read: if isAuthenticated() && (infoCol == 'mandal_info' || infoCol == 'liveStreamInfo');
      allow write: if isAdmin() && (infoCol == 'mandal_info' || infoCol == 'liveStreamInfo');
    }
  }
}
